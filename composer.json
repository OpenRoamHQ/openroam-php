{
  "description": "Official OpenRoam Partner API client: eSIMs, airtime, utility payments, gift cards, hotels and flights.",
  "keywords": [
    "openapitools",
    "openapi-generator",
    "openapi",
    "php",
    "sdk",
    "rest",
    "api"
  ],
  "homepage": "https://openroam.com",
  "license": "MIT",
  "authors": [
    {
      "name": "OpenRoam",
      "email": "support@openroam.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.4.5 || ^8.0",
    "guzzlehttp/psr7": "^2.0 || ^3.0",
    "psr/http-client": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "friendsofphp/php-cs-fixer": "^3.5",
    "overtrue/phplint": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "OpenRoam\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenRoam\\Test\\": "tests/"
    }
  },
  "scripts": {
    "test": [
      "@phplint"
    ],
    "phplint": "phplint"
  }
}
